# App
APP_ENV=local
LOG_LEVEL=INFO
# text (human-readable) or json (one object per line). Secrets are always redacted.
LOG_FORMAT=text

# API
API_HOST=0.0.0.0
API_PORT=8000

# Streamlit
STREAMLIT_API_BASE_URL=http://localhost:8000

# LLM (required by the requirement analyzer, test case generator and test planner)
OPENAI_API_KEY=
OPENAI_BASE_URL=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_S=60
# Retries per model for transient errors (429/5xx), then the fallback models in order.
LLM_MAX_RETRIES=2
LLM_FALLBACK_MODELS=

# LangSmith tracing (optional). Traces LangGraph runs, chains, LLM calls, tool calls,
# knowledge base retrieval and node failures. Off unless both lines below are set.
# Note: traces contain prompts, requirements and test data; see README -> Observability.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ai-qa-agent
# Only for self-hosted or EU instances, e.g. https://eu.api.smith.langchain.com
LANGSMITH_ENDPOINT=

# PostgreSQL (docker compose up -d postgres; then: alembic upgrade head)
POSTGRES_USER=qa
POSTGRES_PASSWORD=qa
POSTGRES_DB=qa_agent
POSTGRES_TEST_DB=qa_agent_test
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://qa:qa@localhost:5432/qa_agent
DATABASE_ECHO=false
# Optional: repository/migration tests also run against PostgreSQL when set
# (the database is migrated down and up, and its tables are truncated).
TEST_DATABASE_URL=

# Human-in-the-loop: a run pauses for review when the root cause confidence is
# below the threshold OR it proposes a sensitive action. Known actions:
# report_bugs, report_high_severity_bugs, reclassify_failure_as_test_issue
CONFIDENCE_THRESHOLD=0.7
SENSITIVE_ACTIONS=report_high_severity_bugs,reclassify_failure_as_test_issue

# RAG / knowledge base
# Index with: python -m qa_agent.rag.ingestion [--rebuild]
KNOWLEDGE_BASE_DIR=knowledge_base
# openai (production) or hashing (offline, word-overlap only; no API key needed)
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
CHROMA_PERSIST_DIR=data/chroma
CHROMA_COLLECTION=qa-knowledge
RAG_TOP_K=4
# Minimum cosine similarity (0-1) for a chunk to be used; tune per embedding model
RAG_MIN_RELEVANCE=0.25
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=150
# Retrieved documents older than this are flagged as possibly outdated
RAG_STALE_AFTER_DAYS=365

# API test execution: the system under test. There is deliberately no default;
# point this at a test/staging environment, never production.
API_TEST_BASE_URL=
# Extra hosts absolute URLs/redirects may reach (comma-separated); base URL host is implied
API_TEST_ALLOWED_HOSTS=
API_TEST_TIMEOUT_S=10
API_TEST_MAX_RESPONSE_BYTES=1000000
API_TEST_VERIFY_TLS=true
API_TEST_FOLLOW_REDIRECTS=false
# Sent as "Authorization: Bearer <token>" unless a test sets its own header
API_TEST_AUTH_TOKEN=
# API tests refuse to run when APP_ENV=production unless this is true
API_TEST_ALLOW_PRODUCTION=false

# UI test execution with Playwright: a local/test web app. No default; never production.
# For development: python -m qa_agent.tools.demo_server  ->  http://127.0.0.1:8765
UI_TEST_BASE_URL=
# Extra hosts the browser may load (comma-separated); requests elsewhere are aborted
UI_TEST_ALLOWED_HOSTS=
UI_TEST_BROWSER=chromium
UI_TEST_HEADLESS=true
UI_TEST_STEP_TIMEOUT_MS=5000
UI_TEST_NAVIGATION_TIMEOUT_MS=15000
# Pages crawled to show the LLM which elements exist
UI_TEST_MAX_INVENTORY_PAGES=5
# Optional directory for failure screenshots (supporting artifact only; off when empty)
UI_TEST_SCREENSHOT_DIR=
UI_TEST_ALLOW_PRODUCTION=false

# --- Docker Compose (docker compose up -d --build) ---------------------------
# Compose reads this same .env. The api container gets it at runtime (env_file); nothing
# is baked into images. Inside the compose network these are overridden automatically:
#   DATABASE_URL        -> postgresql+psycopg://...@postgres:5432/...  (built from POSTGRES_*)
#   API/UI_TEST_BASE_URL -> http://demo:8765                             (the Demo Shop container)
#   STREAMLIT_API_BASE_URL (ui container) -> http://api:8000
# Host ports (published on 127.0.0.1 only):
DEMO_PORT=8765
STREAMLIT_PORT=8501
# Optional: test another system from the containers instead of the demo, e.g.
# DOCKER_API_TEST_BASE_URL=http://host.docker.internal:9000
# DOCKER_UI_TEST_BASE_URL=http://host.docker.internal:9000
